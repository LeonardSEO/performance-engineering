{
  "name": "performance-engineering-plugin",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate && npm test",
    "bench:hooks": "node scripts/benchmark-hooks.mjs",
    "eval:agents": "node scripts/evaluate-agents.mjs",
    "labs:assets": "node labs/build-assets.mjs",
    "labs:start": "node labs/server.mjs",
    "bench:labs": "node scripts/benchmark-labs.mjs",
    "build:release": "node scripts/build-release.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  }
}
